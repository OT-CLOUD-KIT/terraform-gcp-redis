
# Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Local variable files may contain sensitive values
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform CLI configuration
.terraformrc
terraform.rc

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
